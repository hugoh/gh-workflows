---
name: rerun-transient-failures

# workflow_run is safe here: top-level permissions are {}, the one job gets
# only actions:write, nothing checks out the triggering ref, no secrets — it
# just calls `gh run rerun` on the run's own id.
on: # zizmor: ignore[dangerous-triggers]
  workflow_run:
    workflows: << watch_workflows >>
    types: [completed]

permissions: {}

jobs:
  rerun:
    if: ${{ github.event.workflow_run.conclusion == 'failure' }}
    timeout-minutes: 5
    runs-on: ubuntu-latest
    permissions:
      actions: write
    steps:
      - uses: hugoh/rerun-transient-failures@<< rerun_transient_ref >>
        with:
          run-id: ${{ github.event.workflow_run.id }}
