amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v1.4.2/hk-config@1.4.2#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.shell
    ...Base.python
    ["uv-sync"] = {
        dir = "repo-admin"
        check = "uv sync"
    }
    ["pytest"] = {
        dir = "repo-admin"
        check = "uv run pytest"
        profiles = List("ci")
        depends = List("uv-sync")
    }
    ["ty"] {
        depends = List("uv-sync")
    }
    ["tool-bumps-tests"] = {
        dir = "tool-bumps"
        check = "uv run --no-project --python 3.12 python -m unittest discover -p 'test_*.py'"
        profiles = List("ci")
    }
    ["mise-latest-versions-tests"] = {
        dir = "mise-latest-versions"
        check = "uv run --no-project --python 3.12 --with pytest pytest -q"
        profiles = List("ci")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ...Base.commit_msg
        }
    }
}
