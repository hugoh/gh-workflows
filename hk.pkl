amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v1.7.2/hk-config@1.7.2#/base.pkl" as Base

min_hk_version = Base.min_hk_version

local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.shell
    ...Base.python
    ["uv-sync"] = {
        check = "uv sync"
    }
    ["ty"] {
        depends = List("uv-sync")
    }
    ["readme-gen"] = {
        glob = List(
            "*/action.yml",
            ".github/workflows/*.yml",
            "*/README.md",
            "docs/workflows/*.md",
            "mise.toml"
        )
        check = "mise run gen-check"
        fix = "mise run gen"
    }
    ["tool-bumps-tests"] = {
        dir = "tool-bumps"
        check = "uv run --no-project --python 3.12 --with coverage python -m coverage run -m unittest discover -p 'test_*.py' && uv run --no-project --python 3.12 --with coverage python -m coverage report"
        profiles = List("ci")
    }
    ["mise-latest-versions-tests"] = {
        dir = "mise-latest-versions"
        check = "uv run --no-project --python 3.12 --with pytest --with pytest-cov pytest -q --cov --cov-report=term-missing"
        profiles = List("ci")
    }
    ["trim-releases-tests"] = {
        dir = "trim-releases"
        check = "uv run --no-project --python 3.12 --with pytest --with pytest-cov pytest -q --cov --cov-report=term-missing --cov-fail-under=100"
        profiles = List("ci")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ...Base.commit_msg
        }
    }
}
